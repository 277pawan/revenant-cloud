# Copy to .env on the API server (never commit real values).
# See docs/PRODUCTION_DEPLOY.md for full walkthrough.

DATABASE_URL=postgresql://USER:PASS@HOST:5432/revenant_cloud
NODE_ENV=production
API_PORT=8080
API_HOST=0.0.0.0

JWT_SECRET=GENERATE_openssl_rand_-base64_48
JWT_EXPIRES_IN=7d
MASTER_KEY=GENERATE_openssl_rand_-base64_32
RUNNER_TOKEN=GENERATE_openssl_rand_-base64_24

PUBLIC_APP_URL=https://revenant-cloud-web.web.app
CORS_ORIGIN=https://revenant-cloud-web.web.app,https://revenant-cloud-web.firebaseapp.com,https://revenant-verify-933e4.web.app,https://revenant-verify-933e4.firebaseapp.com,http://localhost:5173,http://localhost:3000
PUBLIC_MARKETING_URL=https://revenant-verify-933e4.web.app
PUBLIC_EMAIL_LOGO_URL=https://revenant-verify-933e4.web.app/revenant_logo.png
OAUTH_REDIRECT_BASE_URL=https://revenant-api-171384186168.asia-south1.run.app
COOKIE_SECURE=true
# COOKIE_DOMAIN=.revenant.dev

EMBEDDED_RUNNER=true
EMBEDDED_SCHEDULER=true
REVENANT_CLI_PATH=/usr/local/bin/revenant

ALLOW_OPEN_REGISTRATION=true

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://api.revenant.dev

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

MISTRAL_API_KEY=
MISTRAL_API_URL=https://openrouter.ai/api/v1/chat/completions
MISTRAL_MODEL=mistralai/mistral-small-3.2-24b-instruct

EVIDENCE_DIR=/var/lib/revenant/evidence
