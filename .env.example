# Control-plane Postgres
# Local: localhost. Cloud Run: use a hosted DB (Neon, Supabase, Cloud SQL, etc.)
DATABASE_URL=postgresql://postgres:password@localhost:5432/revenant_cloud

# API — Cloud Run injects PORT=8080; API_PORT is for local dev only
API_PORT=8080
API_HOST=0.0.0.0
NODE_ENV=development

# Auth — generate: openssl rand -base64 32
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_EXPIRES_IN=7d

# Encrypts customer DB passwords at rest (AES-256-GCM). Generate: openssl rand -base64 32
MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Dev: open registration. Set false before any public deploy (invite-only later).
ALLOW_OPEN_REGISTRATION=true

# Cookies — false for local http; true when deployed behind HTTPS
COOKIE_SECURE=false

# CORS — comma-separated: Firebase Hosting + local dev
# Production example:
# CORS_ORIGIN=https://revenant-cloud.web.app,https://revenant-cloud.firebaseapp.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8000
PUBLIC_APP_URL=http://localhost:5173
# PUBLIC_MARKETING_URL=https://your-marketing-site.web.app
# COOKIE_DOMAIN=.revenant.cloud

# Production (Cloud Run) — set via gcloud, not in git:
# NODE_ENV=production
# COOKIE_SECURE=true
# OAUTH_REDIRECT_BASE_URL=https://revenant-api-xxxxx.asia-south1.run.app
# DATABASE_URL=postgresql://... (use Secret Manager for credentials)

# OAuth / SSO (optional — UI shows "coming soon" until set)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# Runner auth for claim/complete (+ embedded worker on npm run dev)
RUNNER_TOKEN=change-me-runner-token-min-16

# auto = on in development (jobs run without a second terminal)
# true/false to force. Production SaaS usually false + customer agent/CI/managed.
EMBEDDED_RUNNER=auto

# Optional: path to revenant binary for real verify (else sibling ../revenant-cli/revenant or PATH)
# REVENANT_CLI_PATH=/home/you/Documents/revenant/revenant-cli/revenant

# Transactional email — password reset + weekly digest (Gmail App Password works)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=you@gmail.com
# SMTP_SECURE=false

# Marketing site contact forms (Talk to us / Buy coffee) — defaults to bpawan277@gmail.com
# CONTACT_NOTIFY_EMAIL=bpawan277@gmail.com

# Proof Composer (Mistral or OpenRouter). OpenRouter keys (sk-or-v1-…) are auto-routed.
# MISTRAL_API_KEY=
# MISTRAL_API_URL=https://openrouter.ai/api/v1/chat/completions
# MISTRAL_MODEL=mistralai/mistral-small-3.2-24b-instruct
# Native Mistral: MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
# Native Mistral: MISTRAL_MODEL=mistral-small-latest
